# SERVER ONLY. No credentials may use the VITE_ prefix.
GATEWAY_URL=http://127.0.0.1:8080
PUBLIC_ORIGIN=http://localhost:5173
PORT=5174
HOST=127.0.0.1
# Generate a random 32-byte hex secret; keep it stable for visitor sessions.
APP_SESSION_SECRET=replace-with-64-hex-characters
WEB_ADMIN_PASSWORD=replace-with-a-long-random-password
# Local development can read service keys from the root .env; Docker passes them explicitly.
# PARSER_API_KEY=
# INTERACTION_API_KEY=
# INTERACTION_ADMIN_API_KEY=
# TELEGRAM_BOT_TOKEN=  # Optional, used only to validate future Mini App initData.
