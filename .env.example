# Settings for the root compose.yaml. AI credentials stay in backend/ai/.env.
# For the existing local volume only: COMPOSE_PROJECT_NAME=bashkiria-db
POSTGRES_USER=bashkiria
POSTGRES_PASSWORD=bashkiria
POSTGRES_DB=bashkiria
# If Windows blocks 5432, use a free port such as 55432.
# Update AI DATABASE_URL only when running the agent outside Docker.
POSTGRES_PORT=5432
GATEWAY_HTTP_PORT=8080
PARSER_HTTP_PORT=5164
PARSER_API_KEY=
PARSER_SCHEDULER_ENABLED=true
PARSER_WORKER_ENABLED=true
SEARCHER_HTTP_PORT=8000
AGENT_HTTP_PORT=8001
PARSER_HTTP_PORT=5164
PARSER_API_KEY=
INTERACTION_HTTP_PORT=5266
INTERACTION_API_KEY=
INTERACTION_ADMIN_API_KEY=
INTERACTION_DELIVERY_API_KEY=
INTERACTION_WORKER_ENABLED=true
WEB_HTTP_PORT=5173
WEB_PUBLIC_ORIGIN=http://localhost:8080
# Generate 32 random bytes encoded as 64 hex characters.
WEB_SESSION_SECRET=
# At least 16 characters; server-side moderator login.
WEB_ADMIN_PASSWORD=
# Optional, only when connecting the Mini App to a bot.
TELEGRAM_BOT_TOKEN=
