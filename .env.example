# Settings for the root compose.yaml. AI credentials stay in backend/ai/.env.
# For the existing local volume only: COMPOSE_PROJECT_NAME=bashkiria-db
POSTGRES_USER=bashkiria
POSTGRES_PASSWORD=bashkiria
POSTGRES_DB=bashkiria
# If Windows blocks 5432, use a free port such as 55432 and update AI DATABASE_URL.
POSTGRES_PORT=5432
GATEWAY_HTTP_PORT=8080
PARSER_HTTP_PORT=5164
PARSER_API_KEY=
PARSER_SCHEDULER_ENABLED=true
PARSER_WORKER_ENABLED=true
SEARCHER_HTTP_PORT=8000
INTERACTION_HTTP_PORT=5266
INTERACTION_API_KEY=
INTERACTION_ADMIN_API_KEY=
INTERACTION_DELIVERY_API_KEY=
INTERACTION_WORKER_ENABLED=true
