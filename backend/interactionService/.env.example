# Development only. This file is copied to backend/interactionService/.env.
ConnectionStrings__InteractionDatabase="Host=localhost;Port=55432;Database=bashkiria;Username=bashkiria;Password=replace-me;Timeout=5;Command Timeout=15"
# Use different random secrets. Never pass these keys to a browser or to the AI model.
Interaction__ApiKey=replace-with-a-random-gateway-key-at-least-32-characters
Interaction__AdminApiKey=replace-with-a-random-admin-key-at-least-32-characters
Interaction__DeliveryApiKey=replace-with-a-random-delivery-key-at-least-32-characters
Interaction__WorkerEnabled=true
