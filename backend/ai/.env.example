# Authorization key from the GigaChat API account (not a temporary access token).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# If a certificate is required, download it as described in README.md.
# GIGACHAT_CA_BUNDLE_FILE=C:/path/to/russian_trusted_root_ca_pem.crt

# Project API keys and URL from your Langfuse account.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional opaque conversation ID for grouping traces (not chat memory).
# CHAT_SESSION_ID=chat-001
