# Authorization key from the GigaChat API account (not a temporary access token).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# For CERTIFICATE_VERIFY_FAILED, download the root CA as described in README.md.
# Relative paths are resolved from backend/ai, independently of the working directory.
# GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt

# Project API keys and URL from your Langfuse account.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Local CLI/HTTP connection. Compose overrides this with postgres:5432 and root POSTGRES_* settings.
# Start PostgreSQL and apply migrations with `docker compose up -d --build postgres migrate`
# from the repository root before using the local chat.
DATABASE_URL=postgresql://bashkiria:bashkiria@localhost:5432/bashkiria
# Number of completed user/assistant pairs, plus the current user message.
# 0 sends only the system prompt and current message. Full history stays in PG.
CHAT_HISTORY_TURNS=5
# Allowed frontend origins for the HTTP API, as a JSON array.
API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
# Service URLs for local HTTP/CLI runs. Compose supplies internal Docker URLs.
SEARCHER_BASE_URL=http://127.0.0.1:8000
PARSER_BASE_URL=http://127.0.0.1:5164
INTERACTION_BASE_URL=http://127.0.0.1:5266
# Match the user API keys configured in parser and interactionService.
PARSER_API_KEY=
INTERACTION_API_KEY=
TOOL_HTTP_TIMEOUT_SECONDS=10
# CLI fallback IDs. HTTP accepts user_id and session_id in the request body.
# CHAT_USER_ID=user-001
# CHAT_SESSION_ID=chat-001
# Optional dedicated test database. Never point integration tests at production.
# TEST_DATABASE_URL=postgresql://bashkiria:bashkiria@localhost:5432/bashkiria_test
