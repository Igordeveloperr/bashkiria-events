# Copy to backend/parser/.env. Loaded automatically only in Development.
# Set the actual published PostgreSQL port (55432 in the current local setup).
ConnectionStrings__ParserDatabase="Host=localhost;Port=55432;Database=bashkiria;Username=bashkiria;Password=replace-me;Timeout=5;Command Timeout=10"
# Optional for Development; required for Production:
# Parser__ApiKey=replace-with-a-long-random-key
# Parser__SchedulerEnabled=true
# Parser__WorkerEnabled=true
