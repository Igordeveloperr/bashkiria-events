{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Parser": {
    "SchedulerEnabled": false,
    "ScheduleIntervalHours": 6,
    "MaxPagesPerRun": 200,
    "MaxListingPages": 5,
    "RequestTimeoutSeconds": 20,
    "RequestDelayMilliseconds": 500,
    "FreshnessHours": 24,
    "Sources": [
      {
        "Id": "gkz", "Kind": "Gkz", "Enabled": true,
        "ListingUrl": "https://gkzbashkortostan.ru/afisha/",
        "EventPathPattern": "^/events/[^/]+/?$", "Priority": 100
      },
      {
        "Id": "culture", "Kind": "Structured", "Enabled": true,
        "ListingUrl": "https://www.culture.ru/afisha/respublika-bashkortostan",
        "EventPathPattern": "^/events/[0-9]+/", "Priority": 50
      }
    ]
  }
}
